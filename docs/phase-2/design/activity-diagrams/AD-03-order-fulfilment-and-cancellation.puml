title AD-03 Order fulfilment and cancellation (UC-18, UC-10, UC-11)
|System|
start
:Order Placed, every item Placed;
repeat
  |Customer|
  if (Cancel requested?) then (yes)
    |System|
    if (Any item Shipped or Delivered?) then (yes)
      :Reject cancellation;
    else (no)
      :Restore stock, mark items and order Cancelled;
      :Refund payment;
      stop
    endif
  else (no)
  endif
  |Seller|
  :Update own item to the next step\nPacked, then Shipped, then Delivered;
  |System|
  :Derive order status from item statuses\n(lowest status held by all items);
repeat while (Some item not Delivered?) is (yes)
->no;
:Order status Delivered;
|Customer|
:May now review the books (UC-12);
stop
@enduml
