@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #000000
skinparam roundcorner 6
skinparam dpi 125
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 150
skinparam sequence {
  ParticipantBackgroundColor #FFFFFF
  ParticipantBorderColor #000000
  LifeLineBorderColor #808080
  ActorBackgroundColor #FFFFFF
  ActorBorderColor #000000
  GroupBackgroundColor #F0F0F0
  GroupBorderColor #808080
  ArrowThickness 1
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #808080
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
title SD-02 Login with lockout (UC-05)
autonumber
actor User
participant "React SPA" as SPA
participant "AuthService\n(BM-01)" as AUTH
database "MongoDB" as DB
User -> SPA : enter email and password
SPA -> AUTH : GET /api/auth/csrf-token
AUTH --> SPA : 200 csrfToken
SPA -> AUTH : POST /api/auth/login\n[CSRF, rate limit, validation]
AUTH -> DB : find user by email
alt user unknown
  AUTH --> SPA : 401 INVALID_CREDENTIALS
else account locked
  AUTH --> SPA : 423 ACCOUNT_LOCKED
else wrong password
  AUTH -> DB : failure count + 1\n(lock 15 min at the 5th)
  AUTH --> SPA : 401 INVALID_CREDENTIALS
else account suspended
  AUTH --> SPA : 403 ACCOUNT_SUSPENDED
else email not verified
  AUTH --> SPA : 403 EMAIL_NOT_VERIFIED
else success
  AUTH -> DB : reset failure count
  AUTH --> SPA : 200 user\nSet-Cookie (HttpOnly, 60 min)
end
@enduml
