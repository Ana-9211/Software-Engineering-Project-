@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #000000
skinparam roundcorner 6
skinparam dpi 125
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 150
skinparam sequence {
  ParticipantBackgroundColor #FFFFFF
  ParticipantBorderColor #000000
  LifeLineBorderColor #808080
  ActorBackgroundColor #FFFFFF
  ActorBorderColor #000000
  GroupBackgroundColor #F0F0F0
  GroupBorderColor #808080
  ArrowThickness 1
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #808080
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
title SD-06 Payment confirmation and order confirmation email (UC-09, UC-08, UC-25)
autonumber
participant "React SPA" as SPA
participant "OrderService\n(BM-06)" as ORD
participant "PaymentService\n(BM-07)" as PAY
participant "Payment Gateway\n(external)" as GW
participant "InventoryService\n(BM-10)" as INV
participant "NotificationService\n(BM-13)" as NOT
participant "Email Service\n(external)" as MAIL
SPA -> ORD : POST /api/orders/:orderId/payment/confirm\n[CSRF, auth, owner]
alt order already Placed
  ORD --> SPA : 200 order (idempotent)
else order PendingPayment
  ORD -> PAY : verifyPayment(order, paymentRef)
  PAY -> GW : verify payment and signature
  GW --> PAY : result
  alt payment not confirmed
    ORD --> SPA : 400 PAYMENT_VERIFICATION_FAILED
  else payment confirmed
    ORD -> INV : finalizeReservation(items)\nstock - qty, reserved - qty
    ORD -> ORD : order Placed, payment succeeded,\ncart cleared (one transaction)
    ORD --> SPA : 200 order Placed
    ORD -> NOT : sendOrderConfirmation(order, user)
    NOT ->> MAIL : confirmation email\n(retried up to 3 times)
  end
end
note over ORD, GW : The gateway webhook runs the same path. If the payment arrives\nafter the reservation expired, OrderService reserves again; if that fails\nthe payment is refunded and the response is 409 ORDER_FAILED_REFUNDED.
@enduml
