@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #000000
skinparam roundcorner 6
skinparam dpi 100
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam rectangle {
  BackgroundColor #F7F7F7
  BorderColor #000000
}
skinparam package {
  BackgroundColor #F7F7F7
  BorderColor #000000
}
skinparam node {
  BackgroundColor #F7F7F7
  BorderColor #000000
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam cloud {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
title Online Bookstore: Domain Overview (classes and relationships)
hide members
skinparam nodesep 30
skinparam ranksep 40
class User
class Address <<embedded>>
class SellerProfile <<embedded>>
class SellerApplication
class AuthToken
class Notification
class Category
class Book
class Review
class Cart
class CartItem <<embedded>>
class Wishlist
class Order
class OrderItem <<embedded>>
class Payment
User "1" *-- "0..5" Address
User "1" *-- "0..1" SellerProfile
User "1" -- "0..*" SellerApplication
User "1" -- "0..*" AuthToken
User "1" -- "0..*" Notification
User "1" -- "0..*" Book : sells
Category "1" -- "0..*" Book
Book "1" -- "0..*" Review
User "1" -- "0..*" Review : writes
User "1" -- "0..1" Cart
Cart "1" *-- "0..*" CartItem
CartItem "0..*" --> "1" Book
User "1" -- "0..1" Wishlist
Wishlist "0..*" --> "0..*" Book
User "1" -- "0..*" Order : places
Order "1" *-- "1..*" OrderItem
OrderItem "0..*" --> "1" Book
OrderItem "0..*" --> "1" User : seller
Order "1" -- "1" Payment
@enduml
