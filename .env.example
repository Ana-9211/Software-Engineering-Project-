# Copy to server/.env (never commit the real file). Names are described in Phase 2 Architecture 7.2.
NODE_ENV=development
PORT=5000
# MongoDB must be a replica set (transactions). `npm run dev:db` starts one on port 27017.
MONGODB_URI=mongodb://127.0.0.1:27017/bookstore?replicaSet=rs0
JWT_SECRET=change-me-to-a-long-random-string
CSRF_SECRET=change-me-to-another-long-random-string
BCRYPT_COST=12

# Payment provider is TBD: only the fake development gateway exists.
# With NODE_ENV=production both PAYMENT_PROVIDER and MAIL_PROVIDER must be set explicitly or the server will not start.
PAYMENT_PROVIDER=fake
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=fake-gateway-secret
PAYMENT_WEBHOOK_SECRET=fake-webhook-secret

# Email provider is TBD: the console mailer prints emails (including links) to the server console
MAIL_PROVIDER=console
MAIL_HOST=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Online Bookstore <no-reply@bookstore.local>

# Pricing values are TBD (A-03): defaults are 5 % tax and a flat 49.00 shipping fee (minor units)
CURRENCY=INR
TAX_RATE_PERCENT=5
SHIPPING_FLAT_FEE=4900

# Links in emails point to the web app (Vite dev server by default)
APP_BASE_URL=http://localhost:5173
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=20
# How long stock stays reserved for an unpaid checkout
RESERVATION_MINUTES=15

# Used by the seed-admin script
ADMIN_EMAIL=admin@bookstore.local
ADMIN_PASSWORD=
# Set to the built React app (client/dist) to serve it from Express (single origin, D-02)
CLIENT_DIST=
